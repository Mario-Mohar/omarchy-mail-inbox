#!/usr/bin/env python3
"""Fetch one message by UID and print its readable body as JSON.

Only the first MAX_BODY_BYTES of the message text are pulled. A mail with a
20 MB attachment would otherwise stall the panel for the sake of a body that
is almost always in the first few kilobytes; MIME puts the text parts before
the attachments, so the truncation costs nothing in practice. The 'truncated'
flag says when that happened, so the panel never implies it showed everything.
"""
import argparse
import email
import email.policy
import os
import re
import sys

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
from mailbody import html_to_text, render_html
from mailcommon import (MAX_ATTACHMENT_NAMES, AccountError, close, connect, decode_field, die, emit,
                        iso_date, require_account)
from mailparts import PartError, attachments, decoded_size, fetch_parts, first_html, human_size

MAX_BODY_BYTES = 262144
MAX_BODY_CHARS = 120000
MAX_BODY_HTML_BYTES = 600000


def part_text(part):
    payload = part.get_payload(decode=True)
    if payload is None:
        return ""
    charset = part.get_content_charset() or "utf-8"
    try:
        return payload.decode(charset, "replace")
    except LookupError:
        return payload.decode("utf-8", "replace")


def extract_body(message):
    """Prefer text/plain; fall back to the first text/html, flattened."""
    plain, rich, names = [], [], []
    for part in message.walk():
        if part.is_multipart():
            continue
        disposition = str(part.get("Content-Disposition", "")).lower()
        filename = part.get_filename()
        if filename or "attachment" in disposition:
            # A message can carry an arbitrary number of parts; only the names
            # are shown, so there is no reason to collect more than a screenful.
            if len(names) < MAX_ATTACHMENT_NAMES:
                names.append(decode_field(filename or "(unnamed)", limit=120))
            continue
        ctype = part.get_content_type()
        if ctype == "text/plain":
            plain.append(part_text(part))
        elif ctype == "text/html":
            rich.append(part_text(part))

    body = "\n\n".join(t for t in plain if t.strip())
    kind = "plain"
    if not body.strip():
        body = html_to_text("\n".join(rich))
        kind = "html"
    if not body.strip():
        body, kind = "", "empty"
    return body[:MAX_BODY_CHARS], kind, names


def body_html(body):
    """Rich text for the reader, or '' to let the panel fall back to plain text.

    Escaping and link targets make the rich form longer than the text. Rather
    than let a huge mail push the whole response over MAX_EMIT_BYTES and lose
    the message entirely, it is dropped and the plain body is shown.
    """
    rich = render_html(body)
    return rich if len(rich.encode("utf-8")) <= MAX_BODY_HTML_BYTES else ""


def structure(conn, uid):
    """(attachmentParts, hasHtml) from BODYSTRUCTURE, or (None, False) without one.

    Each entry carries the index mail-attachment expects, so the panel never
    has to work out section numbers itself.
    """
    try:
        leaves = fetch_parts(conn, uid)
    except PartError:
        return None, False
    found = attachments(leaves)[:MAX_ATTACHMENT_NAMES]
    parts = [{"index": i,
              "name": decode_field(p["name"] or "(unnamed)", limit=120),
              "type": p["type"][:80],
              "size": decoded_size(p),
              "sizeText": human_size(decoded_size(p))}
             for i, p in enumerate(found)]
    return parts, first_html(leaves) is not None


def addresses(raw):
    """Header value -> list of bare addresses, lowercased for comparison."""
    out = []
    for _, addr in email.utils.getaddresses([decode_field(raw, limit=0) or ""]):
        if addr and "@" in addr:
            out.append(addr)
    return out


def fetch(account, uid, expect_validity):
    conn = None
    try:
        conn, validity = connect(account, readonly=True)
        if expect_validity and validity and expect_validity != validity:
            die("mailbox was rebuilt (UIDVALIDITY changed) — refresh and reopen")

        status, payload = conn.uid(
            "FETCH", str(uid),
            "(RFC822.SIZE BODY.PEEK[HEADER] BODY.PEEK[TEXT]<0.%d>)" % MAX_BODY_BYTES)
        if status != "OK" or not payload:
            die("message %s could not be fetched" % uid)

        header_bytes, text_bytes, size = b"", b"", 0
        for item in payload:
            if not isinstance(item, tuple) or len(item) < 2:
                continue
            spec = item[0].decode("ascii", "replace") if isinstance(item[0], (bytes, bytearray)) else ""
            chunk = item[1] if isinstance(item[1], (bytes, bytearray)) else b""
            if "HEADER" in spec:
                header_bytes = bytes(chunk)
            elif "TEXT" in spec:
                text_bytes = bytes(chunk)
            match = re.search(r"RFC822\.SIZE (\d+)", spec)
            if match:
                size = int(match.group(1))

        if not header_bytes:
            die("message %s is gone from the mailbox" % uid)

        message = email.message_from_bytes(header_bytes + b"\r\n" + text_bytes,
                                           policy=email.policy.compat32)
        body, kind, names = extract_body(message)
        parts, has_html = structure(conn, uid)
        if parts is not None:
            # The structure sees past the 256 KB that were downloaded, so it is
            # the better list whenever the server provides one.
            names = [p["name"] for p in parts]
        else:
            has_html = kind == "html"

        own = str(account.get("from") or account.get("user") or "").lower()
        reply_to = addresses(message.get("Reply-To", "")) or addresses(message.get("From", ""))
        cc_all = [a for a in addresses(message.get("To", "")) + addresses(message.get("Cc", ""))
                  if a.lower() != own and a.lower() not in {r.lower() for r in reply_to}]

        references = " ".join((decode_field(message.get("References", ""), limit=0) + " "
                               + decode_field(message.get("Message-ID", ""), limit=0)).split())

        return {
            "uid": str(uid),
            "account": str(account.get("id", "")),
            "from": decode_field(message.get("From", "")),
            "to": decode_field(message.get("To", "")),
            "cc": decode_field(message.get("Cc", "")),
            "subject": decode_field(message.get("Subject", "")) or "(no subject)",
            "date": iso_date(message.get("Date", "")),
            "body": body,
            "bodyHtml": body_html(body),
            "bodyKind": kind,
            "attachments": names,
            "attachmentParts": parts or [],
            "hasHtml": has_html,
            "truncated": bool(size and size > len(header_bytes) + MAX_BODY_BYTES),
            "messageId": decode_field(message.get("Message-ID", ""), limit=0),
            "references": references,
            "replyTo": reply_to,
            "replyAllCc": cc_all,
            "error": "",
        }
    finally:
        close(conn)


def main():
    parser = argparse.ArgumentParser(description="Print one message as JSON.")
    parser.add_argument("--account", required=True)
    parser.add_argument("--uid", required=True)
    parser.add_argument("--uidvalidity", default="")
    args = parser.parse_args()

    try:
        account = require_account(args.account)
        emit(fetch(account, args.uid, args.uidvalidity.strip()))
    except AccountError as exc:
        emit({"uid": args.uid, "account": args.account, "body": "",
              "attachments": [], "replyTo": [], "replyAllCc": [], "error": str(exc)})
    except Exception as exc:
        emit({"uid": args.uid, "account": args.account, "body": "",
              "attachments": [], "replyTo": [], "replyAllCc": [],
              "error": "%s: %s" % (type(exc).__name__, str(exc)[:150])})


if __name__ == "__main__":
    main()
