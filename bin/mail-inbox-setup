#!/usr/bin/env bash
# Asks for the password of every configured account and tests the connection.
# With no account configured yet it starts the wizard instead, so the panel's
# "Add a mailbox" button lands somewhere that can actually add one.
set -uo pipefail
HERE="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"

echo "Omarchy Mail Inbox — store passwords"
echo

# The same hardened reader the widget uses: it refuses a file with the wrong
# owner or mode and says how to fix it, rather than this script crashing.
if ! listing="$(python3 -c '
import sys
sys.path.insert(0, sys.argv[1])
from mailcommon import AccountError, load_accounts
try:
    accounts = load_accounts()
except AccountError as exc:
    sys.exit(str(exc))
for a in accounts:
    if a.get("id"):
        print(a["id"], a.get("user", ""), sep="\t")
' "$HERE")"; then
  echo
  read -r -p "Fix that and run this again. Press Enter to close. " _
  exit 1
fi

if [ -z "$listing" ]; then
  echo "No mailbox configured yet, starting the wizard."
  echo
  "$HERE/mail-inbox-account" add
  echo
  read -r -p "Press Enter to close. " _
  exit 0
fi

mapfile -t IDS <<< "$listing"

for line in "${IDS[@]}"; do
  id="${line%%$'\t'*}"; user="${line#*$'\t'}"
  if secret-tool lookup service omarchy-mail-inbox account "$id" 2>/dev/null | grep -q .; then
    echo "✓ $id ($user) — already in the keyring, skipping."
    continue
  fi
  echo "── $id — $user"
  [ "$id" = "gmail" ] && echo "   Gmail needs an app password: https://myaccount.google.com/apppasswords"
  secret-tool store --label "Omarchy Mail Inbox: $id" service omarchy-mail-inbox account "$id"
  echo
done

echo "Testing connections…"
echo
for line in "${IDS[@]}"; do
  id="${line%%$'\t'*}"
  printf '%-10s ' "$id"
  "$HERE/mail-inbox-account" test "$id" 2>&1 | head -1
done
echo
read -r -p "Done. Press Enter to close. " _
