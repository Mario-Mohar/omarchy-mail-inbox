#!/usr/bin/env python3
"""Manage mailboxes for the Omarchy Mail Inbox widget.

Server details go to ~/.config/omarchy/mail-inbox/accounts.json.
Passwords go to the login keyring — never to that file.
"""
import argparse
import collections
import getpass
import json
import os
import stat
import subprocess
import sys

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
from mailcommon import load_accounts  # noqa: E402  (hardened reader)

CONFIG_DIR = os.path.expanduser("~/.config/omarchy/mail-inbox")
ACCOUNTS_FILE = os.path.join(CONFIG_DIR, "accounts.json")
KEYRING_SERVICE = "omarchy-mail-inbox"
HERE = os.path.dirname(os.path.realpath(__file__))

# The starttls field is not decoration: Proton Bridge listens on 1143 and
# speaks STARTTLS, so an account written without it gets an implicit-TLS
# handshake against a port that will not answer one, and the mailbox never
# connects. Everything else here is implicit TLS on 993.
#
# The smtp fields carry the sending side, so that picking a preset settles
# replying too. Without them the wizard wrote a read-only account and the
# first reply failed at send time, after it had been typed.
Preset = collections.namedtuple(
    "Preset", "host port starttls smtp_host smtp_port smtp_mode")

PRESETS = {
    # Proton Bridge is the odd one twice over: SMTP is on 1025, not 587.
    "proton":  Preset("127.0.0.1", 1143, True, "127.0.0.1", 1025, "starttls"),
    "gmail":   Preset("imap.gmail.com", 993, False, "smtp.gmail.com", 465, "ssl"),
    "icloud":  Preset("imap.mail.me.com", 993, False, "smtp.mail.me.com", 587, "starttls"),
    "outlook": Preset("outlook.office365.com", 993, False, "smtp.office365.com", 587, "starttls"),
    "gmx":     Preset("imap.gmx.net", 993, False, "mail.gmx.net", 587, "starttls"),
    "web.de":  Preset("imap.web.de", 993, False, "smtp.web.de", 587, "starttls"),
    "mailbox": Preset("imap.mailbox.org", 993, False, "smtp.mailbox.org", 587, "starttls"),
}


def smtp_mode_for(port):
    """465 is implicit TLS; 587, 25 and Proton's 1025 are all STARTTLS.

    Same trick as the IMAP side, where the port already decides the default:
    one fewer question, and the answer that gets guessed wrong by hand.
    """
    return "ssl" if port == 465 else "starttls"


def load():
    # Same hardened reader the widget uses, so both agree on what is acceptable.
    return load_accounts()


def _require_safe_dir(path):
    """The directory we are about to write into must be ours and not writable
    by anyone else, or a third party could swap the file we just replaced."""
    fd = os.open(path, os.O_RDONLY | os.O_DIRECTORY | getattr(os, "O_CLOEXEC", 0))
    try:
        info = os.fstat(fd)
        if info.st_uid != os.geteuid():
            sys.exit("%s is owned by uid %d, not by you" % (path, info.st_uid))
        if info.st_mode & stat.S_IWOTH and not info.st_mode & stat.S_ISVTX:
            sys.exit("%s is world-writable" % path)
        if info.st_mode & stat.S_IWGRP:
            sys.exit("%s is group-writable — run: chmod 700 %s" % (path, path))
    finally:
        os.close(fd)


def save(accounts):
    """Atomic, symlink-safe replace.

    The temporary file is created with O_EXCL and mode 600 from the start:
    creating it first and calling chmod afterwards leaves a window in which the
    file exists with the default mode, and the passwords are not in here but
    the server names and addresses are.
    """
    os.makedirs(CONFIG_DIR, mode=0o700, exist_ok=True)
    _require_safe_dir(CONFIG_DIR)

    tmp = ACCOUNTS_FILE + ".tmp"
    flags = os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW
    flags |= getattr(os, "O_CLOEXEC", 0)
    try:
        fd = os.open(tmp, flags, 0o600)
    except FileExistsError:
        os.unlink(tmp)
        fd = os.open(tmp, flags, 0o600)

    try:
        with os.fdopen(fd, "w", encoding="utf-8", closefd=False) as fh:
            json.dump({"accounts": accounts}, fh, indent=2, ensure_ascii=False)
            fh.write("\n")
            fh.flush()
            os.fsync(fd)
    finally:
        os.close(fd)

    os.replace(tmp, ACCOUNTS_FILE)


def store_password(account_id, password):
    proc = subprocess.run(
        ["secret-tool", "store", "--label", "Omarchy Mail Inbox: %s" % account_id,
         "service", KEYRING_SERVICE, "account", account_id],
        input=password.encode(), capture_output=True)
    if proc.returncode != 0:
        sys.exit("keyring write failed: %s" % proc.stderr.decode().strip())


def cmd_add(args):
    accounts = load()
    print("Adding a mailbox. Ctrl+C aborts.\n")
    account_id = args.id or input("Short id (no spaces, e.g. gmail): ").strip()
    if not account_id or " " in account_id:
        sys.exit("id must be non-empty and contain no spaces")
    if any(a.get("id") == account_id for a in accounts):
        sys.exit("id '%s' already exists — remove it first" % account_id)

    print("Presets: %s" % ", ".join(sorted(PRESETS)))
    preset = input("Preset (blank for manual): ").strip().lower()
    known = preset in PRESETS
    smtp_host = smtp_port = smtp_mode = None
    sender = ""

    if known:
        chosen = PRESETS[preset]
        host, port, starttls = chosen.host, chosen.port, chosen.starttls
        smtp_host, smtp_port, smtp_mode = (
            chosen.smtp_host, chosen.smtp_port, chosen.smtp_mode)
        print("  -> IMAP %s:%s (%s)"
              % (host, port, "STARTTLS" if starttls else "implicit TLS"))
        print("  -> SMTP %s:%s (%s)"
              % (smtp_host, smtp_port,
                 "STARTTLS" if smtp_mode == "starttls" else "implicit TLS"))
    else:
        host = input("IMAP host: ").strip()
        port = int(input("Port [993]: ").strip() or 993)
        # Asked rather than guessed, but the usual ports make a sensible
        # default. A hand-entered STARTTLS server would otherwise hit exactly
        # the failure the proton preset used to produce.
        suggested = port in (143, 1143)
        answer = input("STARTTLS instead of implicit TLS? [%s]: "
                       % ("Y/n" if suggested else "y/N")).strip().lower()
        starttls = answer.startswith("y") if answer else suggested

    user = input("Username / email address: ").strip()
    label = input("Bar label [%s]: " % account_id).strip() or account_id
    folder = input("Folder [INBOX]: ").strip() or "INBOX"

    if not known:
        # Replying is half of what this widget is for, so ask -- but anyone who
        # only wants to read gets past it with one keystroke. Declining leaves
        # the fields out of the file entirely, and mail-send keeps saying what
        # is missing if a reply is attempted anyway.
        answer = input("\nSet up sending (SMTP) too, so you can reply? [Y/n]: ")
        if not answer.strip().lower().startswith("n"):
            smtp_host = input("SMTP host [%s]: " % host).strip() or host
            # An implicit-TLS mailbox almost always sends on 465 and a STARTTLS
            # one on 587, so the IMAP answer already picked this.
            default_port = 587 if starttls else 465
            smtp_port = int(input("SMTP port [%d]: " % default_port).strip()
                            or default_port)
            smtp_mode = smtp_mode_for(smtp_port)
            print("  -> %s"
                  % ("STARTTLS" if smtp_mode == "starttls" else "implicit TLS"))
            sender = input("From address [%s]: " % user).strip()

    if preset == "gmail":
        print("\nGmail needs an App Password, not your normal password.")
        print("Create one at https://myaccount.google.com/apppasswords")
        print("(requires 2-step verification to be switched on).\n")

    password = getpass.getpass("Password / app password (not echoed): ")
    if not password:
        sys.exit("empty password")

    store_password(account_id, password)
    entry = {"id": account_id, "label": label, "host": host,
             "port": port, "user": user, "folder": folder}
    if starttls:
        entry["starttls"] = 1
    if smtp_host:
        entry["smtpHost"] = smtp_host
        entry["smtpPort"] = smtp_port
        entry["smtpMode"] = smtp_mode
        # mail-send falls back to `user`, so only a differing address is worth
        # writing down.
        if sender and sender != user:
            entry["from"] = sender
    accounts.append(entry)
    save(accounts)
    print("\nSaved. Server details in %s, password in the keyring." % ACCOUNTS_FILE)
    print("Testing…\n")
    cmd_test(argparse.Namespace(id=account_id))


def cmd_list(args):
    accounts = load()
    if not accounts:
        print("No accounts yet. Run: mail-inbox-account add")
        return
    print("%-12s %-26s %-28s %s" % ("ID", "LABEL", "USER", "HOST"))
    for a in accounts:
        print("%-12s %-26s %-28s %s:%s" % (
            a.get("id", ""), a.get("label", ""), a.get("user", ""),
            a.get("host", ""), a.get("port", "")))


def cmd_remove(args):
    accounts = load()
    remaining = [a for a in accounts if a.get("id") != args.id]
    if len(remaining) == len(accounts):
        sys.exit("no such account: %s" % args.id)
    save(remaining)
    subprocess.run(["secret-tool", "clear", "service", KEYRING_SERVICE,
                    "account", args.id], capture_output=True)
    print("Removed '%s' and cleared its keyring entry." % args.id)


def cmd_test(args):
    proc = subprocess.run([os.path.join(HERE, "mail-check"),
                           "--account", args.id, "--limit", "5"],
                          capture_output=True)
    try:
        result = json.loads(proc.stdout.decode() or "{}")
    except ValueError:
        sys.exit("backend returned junk: %s" % proc.stdout.decode()[:200])
    if result.get("error"):
        sys.exit("FAILED: %s" % result["error"])
    print("OK — %d unread in %s" % (result.get("unread", 0), args.id))
    for m in result.get("messages", [])[:5]:
        print("   %-24s %s" % (m["from"][:24], m["subject"][:60]))
    report_smtp(args.id)


def report_smtp(account_id):
    """Say whether replying would work, without sending anything.

    A missing SMTP block used to surface only at send time, with the reply
    already typed. Reading it back off the saved account also proves the
    wizard wrote what it said it would.
    """
    account = next((a for a in load() if a.get("id") == account_id), {})
    host = str(account.get("smtpHost", "")).strip()
    if not host:
        print("SMTP: not configured — reading works, replying will not.")
        print("      Add smtpHost, smtpPort and smtpMode to %s." % ACCOUNTS_FILE)
        return
    mode = str(account.get("smtpMode", "ssl")).strip().lower()
    port = account.get("smtpPort") or (587 if mode == "starttls" else 465)
    print("SMTP: %s:%s (%s), replies from %s"
          % (host, port, "STARTTLS" if mode == "starttls" else "implicit TLS",
             account.get("from") or account.get("user", "")))


def main():
    parser = argparse.ArgumentParser(description=__doc__,
                                     formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = parser.add_subparsers(dest="cmd", required=True)
    p_add = sub.add_parser("add", help="add a mailbox interactively")
    p_add.add_argument("id", nargs="?", help="short id")
    p_add.set_defaults(func=cmd_add)
    sub.add_parser("list", help="list configured mailboxes").set_defaults(func=cmd_list)
    p_rm = sub.add_parser("remove", help="remove a mailbox")
    p_rm.add_argument("id")
    p_rm.set_defaults(func=cmd_remove)
    p_test = sub.add_parser("test", help="poll a mailbox once")
    p_test.add_argument("id")
    p_test.set_defaults(func=cmd_test)
    args = parser.parse_args()
    args.func(args)


if __name__ == "__main__":
    main()
